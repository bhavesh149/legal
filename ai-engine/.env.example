# --- Service ---
ENVIRONMENT=local                # local | production
LOG_LEVEL=INFO
API_INTERNAL_TOKEN=change-me-shared-secret   # shared secret between NestJS gateway and this service

# --- Groq (LLM) ---
GROQ_API_KEY=gsk_xxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FAST=llama-3.1-8b-instant          # query condensation, auto-tagging, guardrails
LLM_MODEL_DEFAULT=openai/gpt-oss-120b        # contract analysis + chat answers
LLM_MODEL_LONG_CONTEXT=moonshotai/kimi-k2-instruct-0905  # long contracts (>~40k tokens)
LLM_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m

# Per-model rate-limit ceilings (Groq base/dev tier) used to size internal semaphores.
GROQ_RPM_DEFAULT=30
GROQ_TPM_DEFAULT=8000
GROQ_RPM_FAST=30
GROQ_TPM_FAST=6000

# --- Redis (jobs, conversations, rate limiting, caches) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_STANDARDS=standard_clauses
QDRANT_COLLECTION_DOCUMENTS=document_chunks
CORPUS_VERSION=v1

# --- Object storage (S3-compatible: MinIO locally, AWS S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000     # unset/blank in production to use real AWS S3
S3_BUCKET=legal-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true                    # required for MinIO; set false on real AWS S3

# --- Feature flags ---
ENABLE_PII_ANONYMIZATION=false            # MVP: privacy engine deferred, off by default
ENABLE_OCR_FALLBACK=true

# --- Retention ---
DOCUMENT_CHUNK_TTL_SECONDS=604800         # 7 days
JOB_RESULT_TTL_SECONDS=86400              # 1 day
CONVERSATION_TTL_SECONDS=604800           # 7 days
CONVERSATION_MAX_TURNS_VERBATIM=8         # sliding window before summarizing

# --- Rate limiting (per authenticated user, at the API edge) ---
USER_RATE_LIMIT_PER_MINUTE=20
